@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false

title Complete Customer Order to Delivery Flow

' Customer Section
package "CUSTOMER" #E3F2FD {
    usecase "Send Hi" as UC1
    usecase "Register\n(Name, Phone, Location)" as UC2
    usecase "Send start" as UC3
    usecase "Browse Products" as UC4
    usecase "Select Fish\n+ Quantity" as UC5
    usecase "Click Checkout" as UC6
    usecase "Click Confirm Order" as UC7 #2196F3
    usecase "Receive:\nOrder Confirmed #123" as UC8 #4CAF50
    usecase "Receive:\nDelivery Person Assigned" as UC9 #4CAF50
}

' Backend Section
package "BACKEND SYSTEM" #FFF9C4 {
    usecase "Create Order\nStatus: PENDING" as B1
    database "Database" as DB
    usecase "Send to\nDelivery Group" as B3
    usecase "Validate\nDelivery Person Role" as B4 #FFE082
    usecase "Update Order\nStatus: CONFIRMED" as B5 #81C784
    usecase "Save Delivery\nPerson Details" as B6 #81C784
}

' Delivery Group Section
package "DELIVERY GROUP" #FFB74D {
    usecase "Receive Order\nNotification" as D1
    usecase "NEW ORDER #123\n+ Confirm Button" as D2 #FF9800
    usecase "Delivery Person\nClicks Button" as D3 #FF9800
    usecase "Receive:\nORDER CONFIRMED\nwith DP details" as D4 #66BB6A
}

' Customer Flow
UC1 --> UC2
UC2 --> UC3
UC3 --> UC4
UC4 --> UC5
UC5 --> UC6
UC6 --> UC7

' Order Placement Flow
UC7 -right-> B1 : 10:00 AM
B1 --> DB
DB --> B3

' Delivery Group Notification
B3 -right-> D1 : 10:00 AM
D1 --> D2
D2 --> D3

' Delivery Confirmation Flow
D3 -left-> B4 : 10:05 AM
B4 --> B5 : Role Verified
B5 --> B6
B6 --> DB

' Notifications
B6 ..> UC9 : Notify Customer
UC7 ..> UC8 : Receives
UC8 ..> UC9 : Later
B6 -right-> D4 : 10:05 AM

legend right
  |= Color |= Meaning |
  | <#E3F2FD> | Customer Actions |
  | <#2196F3> | Customer Confirm |
  | <#4CAF50> | Success Messages |
  | <#FFF9C4> | Backend Processing |
  | <#FFE082> | Validation |
  | <#81C784> | Database Updates |
  | <#FFB74D> | Delivery Group |
  | <#FF9800> | Delivery Actions |
  | <#66BB6A> | Confirmation |
endlegend

@enduml
